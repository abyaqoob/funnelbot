# FunnelBot Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
ADMIN_PASSWORD=demo-funnel-pass-2026
DEMO_MODE=true

# Database (default SQLite, or swap to PostgreSQL on Neon/Supabase)
DATABASE_URL=sqlite:///./funnelbot.db

# Optional Free-Tier LLM Provider (options: none, groq, gemini)
LLM_PROVIDER=none
GROQ_API_KEY=
GEMINI_API_KEY=

# Telegram Adapter
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Instagram Adapter (Dev-mode stub)
INSTAGRAM_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
